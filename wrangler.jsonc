// Cloudflare Workers static-assets config for ktcalc.com.
// Assets-only Worker: no `main` script, so every request is served straight
// from build/ and costs nothing. Deployed by .github/workflows/deploy.yml.
// Netlify still builds the same build/ folder; both run side by side until the
// DNS cutover in CLOUDFLARE_CUTOVER.md.
{
  "name": "ktcalc",
  "compatibility_date": "2026-09-22",
  "assets": {
    // `npm run build:cloudflare` output: the same CRA build + react-snap
    // prerendered pages Netlify serves, minus Netlify's _redirects (see
    // scripts/strip-netlify-redirects.js). _headers is used by both hosts.
    "directory": "./build",
    // Replaces Netlify's `/*  /index.html  200` rule: a URL with no file
    // gets the root index.html and the client router takes over. Prerendered
    // pages (fight/index.html, rules/*/index.html, ...) are real files, so
    // they are served first and never fall through to this.
    "not_found_handling": "single-page-application",
    // Default, spelled out: folder/index.html is served at `folder/` and
    // `folder` redirects there, like Netlify's pretty URLs. The canonicals and
    // sitemap already use the trailing-slash form.
    "html_handling": "auto-trailing-slash"
  },
  // Serve on ktcalc.<subdomain>.workers.dev until the cutover adds the
  // ktcalc.com custom domain, and allow per-PR Preview URLs.
  "workers_dev": true,
  "preview_urls": true
}
